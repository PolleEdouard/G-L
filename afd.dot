digraph AFD {
    rankdir=LR;
    node [fontname="Arial"];

    start [shape=none, label=""];
    start -> 0;

    0 [label="{ q0 }", shape=circle];
    1 [label="{ q0, q2, q3 }", shape=doublecircle];
    2 [label="{ q0, q3 }", shape=doublecircle];
    3 [label="{ q2, q3 }", shape=doublecircle];
    4 [label="{ q0, q1, q2, q3 }", shape=doublecircle];
    5 [label="{  }", shape=circle];
    6 [label="{ q0, q1, q3 }", shape=doublecircle];

    0 -> 1 [label="a"];
    0 -> 2 [label="b"];
    0 -> 3 [label="c"];
    1 -> 4 [label="a"];
    1 -> 2 [label="b"];
    1 -> 1 [label="c"];
    2 -> 1 [label="a"];
    2 -> 2 [label="b"];
    2 -> 1 [label="c"];
    3 -> 4 [label="a"];
    3 -> 5 [label="b"];
    3 -> 1 [label="c"];
    4 -> 4 [label="a"];
    4 -> 6 [label="b"];
    4 -> 1 [label="c"];
    5 -> 5 [label="a"];
    5 -> 5 [label="b"];
    5 -> 5 [label="c"];
    6 -> 1 [label="a"];
    6 -> 6 [label="b"];
    6 -> 1 [label="c"];
}
